--[[
    Chilli Hub V8
    Modern Glassmorphism Key System
    Check Key + Get Key
    No Input Border Edition
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer
local PlayerGui = Player:FindFirstChild("PlayerGui") or CoreGui

--==================================================
-- CONFIGURATION
--==================================================

local CORRECT_KEY = "ChilliHubV8KeyKsjwowowoj - Kalwojwnwkeoejeno"

local LINK_GET_KEY = "https://link4m.net/VsKae90J"

local SAVE_FILE_NAME = "ChilliHubV8_KeyData.json"
local CACHE_DURATION = 86400

local ACCENT = Color3.fromRGB(240, 40, 60)
local BACKGROUND = Color3.fromRGB(12, 12, 16)
local WHITE = Color3.fromRGB(255, 255, 255)

--==================================================
-- MAIN SCRIPT
--==================================================

local function loadMainScript()
    local success, err = pcall(function()
        local source = game:HttpGet(
            "https://raw.githubusercontent.com/napun87/stealanegg/refs/heads/main/chilli.otcaydodaiNoKey3.7.lua"
        )

        local func = loadstring(source)

        if not func then
            error("Unable to compile main script")
        end

        func()
    end)

    if not success then
        warn("Main Script Loading Error:", err)
    end
end

--==================================================
-- KEY CACHE
--==================================================

local function checkSavedKey()
    if not (readfile and isfile and delfile) then
        return false
    end

    if not isfile(SAVE_FILE_NAME) then
        return false
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(
            readfile(SAVE_FILE_NAME)
        )
    end)

    if not success or not data then
        return false
    end

    if data.Key == CORRECT_KEY then
        if os.time() - data.Time < CACHE_DURATION then
            return true
        end
    end

    pcall(function()
        delfile(SAVE_FILE_NAME)
    end)

    return false
end

local function saveKeyLocally()
    if not writefile then
        return
    end

    local data = {
        Key = CORRECT_KEY,
        Time = os.time()
    }

    pcall(function()
        writefile(
            SAVE_FILE_NAME,
            HttpService:JSONEncode(data)
        )
    end)
end

--==================================================
-- CACHE CHECK
--==================================================

if checkSavedKey() then
    loadMainScript()
    return
end

--==================================================
-- REMOVE OLD UI
--==================================================

pcall(function()
    local old = PlayerGui:FindFirstChild(
        "ChilliKeySystemV8"
    )

    if old then
        old:Destroy()
    end
end)

