--==================================================
-- BUTTON ANIMATIONS
--==================================================

local function animateButton(button, originalColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(0.2),
            {
                BackgroundColor3 = Color3.fromRGB(55, 25, 32)
            }
        ):Play()
    end)

    button.MouseLeave:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(0.2),
            {
                BackgroundColor3 = originalColor
            }
        ):Play()
    end)
end

animateButton(CheckButton, ACCENT)
animateButton(GetKeyButton, Color3.fromRGB(25, 20, 25))

--==================================================
-- SHAKE ANIMATION
--==================================================

local function shakeFrame()
    local originalPosition = MainFrame.Position

    local offsets = {
        7, -7, 5, -5, 3, -3, 0
    }

    task.spawn(function()
        for _, offset in ipairs(offsets) do
            local tween = TweenService:Create(
                MainFrame,
                TweenInfo.new(
                    0.035,
                    Enum.EasingStyle.Sine,
                    Enum.EasingDirection.Out
                ),
                {
                    Position = UDim2.new(
                        originalPosition.X.Scale,
                        originalPosition.X.Offset + offset,
                        originalPosition.Y.Scale,
                        originalPosition.Y.Offset
                    )
                }
            )

            tween:Play()
            tween.Completed:Wait()
        end

        MainFrame.Position = originalPosition
    end)
end

--==================================================
-- GET KEY ACTION
--==================================================

GetKeyButton.MouseButton1Click:Connect(function()
    local success = false

    if setclipboard then
        success = pcall(function()
            setclipboard(LINK_GET_KEY)
        end)
    end

    if success then
        showNotification("GET KEY LINK COPIED!", true)
    else
        showNotification("Clipboard unavailable!", false)
    end
end)

--==================================================
-- CHECK KEY ACTION
--==================================================

local checking = false

CheckButton.MouseButton1Click:Connect(function()
    if checking then
        return
    end

    checking = true
    CheckButton.Text = "CHECKING..."

    local enteredKey = TextBox.Text

    if enteredKey == CORRECT_KEY then
        showNotification("ACCESS GRANTED! LOADING...", true)

        saveKeyLocally()

        task.wait(0.6)

        ScreenGui:Destroy()

        loadMainScript()
    else
        showNotification("INVALID KEY! TRY AGAIN.", false)

        shakeFrame()

        TextBox.Text = ""
        TextBox:CaptureFocus()

        task.wait(0.3)

        CheckButton.Text = "CHECK KEY"
        checking = false
    end
end)

